      "parameters": {
        "jsCode": "// Format lucas_api response for Discord\nconst resp = $input.first().json;\nlet message = '';\n\nif (resp.status === 'success') {\n    message = resp.data;\n    const agentLabel = resp.agent && resp.agent !== 'llm' ? `[${resp.agent}] ` : '';\n    const timeLabel = resp.elapsed ? ` \\`(${Math.round(resp.elapsed/1000)}s)\\`` : '';\n    message = agentLabel + message + timeLabel;\n} else {\n    message = `❌ 處理失敗：${resp.data || '未知錯誤'}`;\n}\n\nreturn { content: message, channel_id: $json.channel_id };\n"
      }
