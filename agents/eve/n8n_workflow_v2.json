      "parameters": {
        "jsCode": "// Extract and normalize Discord payload\nconst body = $input.first().json.body || $input.first().json;\nconst content = (body.content || '').trim();\nconst channel_id = body.channel_id || (body.message ? body.message.channel_id : '');\nconst author = body.author || (body.message ? body.message.author : {});\nconst message_id = body.id || (body.message ? body.message.id : '');\n\n// Detect if message mentions Lucas\nconst mentionsLucas = /lucas/i.test(content);\n\n// Determine profile based on channel and content\nlet profile = 'brain';  // default\nif (channel_id === '1506345048625905816') {\n    profile = 'brain';  // #ryan-private → Lucas brain\n} else if (channel_id === '1506239471325020327') {\n    profile = 'secretary';  // #大廳 → 八雲 secretary\n}\n// If content mentions Lucas, override to brain\nif (mentionsLucas) {\n    profile = 'brain';\n}\n\nreturn {\n    content,\n    channel_id,\n    message_id,\n    author_id: author.id || '',\n    author_name: author.username || author.globalName || '',\n    mentionsLucas,\n    profile,\n    taskId: `n8n-${message_id || Date.now()}`,\n};\n"
      }
    },
